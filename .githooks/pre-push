#!/bin/sh
#
# Pre-push gate for the ontology: the V5 ROBOT gate must be green before
# pushing. CI re-runs it in a clean environment. Bypass with:
# git push --no-verify
#
set -eu

echo "pre-push > make -C v5 test (ROBOT: v5 ontology + examples must be consistent)"
make -C v5 test

echo "pre-push > all checks passed"
