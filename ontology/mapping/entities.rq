# Actions, charters and objectives keep their IRIs; title, body and created
# time carry over as label and Dublin Core annotations (convention 2).
PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  ?e a ?class ; rdfs:label ?label ; dcterms:description ?description ; dcterms:created ?created .
} WHERE {
  VALUES (?appClass ?class) {
    (app:Action obo:IAO_0000007)       # action specification
    (app:Charter cco:ont00000974)      # Plan
    (app:Objective cco:ont00000476)    # Objective
  }
  ?e a ?appClass .
  OPTIONAL { ?e rdfs:label ?label }
  OPTIONAL { ?e dcterms:description ?description }
  OPTIONAL { ?e dcterms:created ?created }
}
