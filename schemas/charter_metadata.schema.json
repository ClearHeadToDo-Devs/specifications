{
       "$schema": "http://json-schema.org/draft-07/schema#",
       "$id": "https://raw.githubusercontent.com/ClearHeadToDo-Devs/specifications/master/schemas/charter_metadata.schema.json",
       "title": "Charter Metadata",
       "description": "Per-charter sidecar for machine-oriented metadata that does not belong in human-readable .actions or .ics files. Keyed by domain concept (charter, actions, plans) with entries keyed by identifier.",
       "type": "object",
       "properties": {
              "charter": {
                     "type": "object",
                     "description": "Metadata about the charter itself",
                     "properties": {
                            "id": {
                                   "type": "string",
                                   "format": "uuid",
                                   "description": "The charter's identity, recorded so the sidecar re-joins its charter by id rather than by file path (move-safe, and works for a charter with no actions). A reference: the charter's own declaration (frontmatter `id`, or the file itself for an action-only charter) is authoritative and doctor verifies agreement."
                            },
                            "created": {
                                   "type": "string",
                                   "description": "ISO 8601 creation timestamp"
                            }
                     },
                     "additionalProperties": true
              },
              "actions": {
                     "type": "object",
                     "description": "Metadata keyed by action identifier",
                     "additionalProperties": {
                            "type": "object",
                            "description": "Metadata for a single planned action",
                            "properties": {
                                   "created": {
                                          "type": "string",
                                          "description": "ISO 8601 creation timestamp"
                                   },
                                   "occurrence": {
                                          "type": "object",
                                          "description": "Frozen lineage for an archived materialized recurring occurrence. Live occurrence lineage is hydrated from the plans sync store; completed archives snapshot the fact so future plan edits/deletion do not rewrite history.",
                                          "properties": {
                                                 "plan_id": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "description": "UUID of the recurring Plan this occurrence realized"
                                                 },
                                                 "plan_uid": {
                                                        "type": "string",
                                                        "description": "iCalendar UID of the recurring VTODO master at crystallization time"
                                                 },
                                                 "occurrence_key": {
                                                        "type": "string",
                                                        "description": "Canonical recurrence slot key (RECURRENCE-ID/EXDATE key) realized by this occurrence"
                                                 },
                                                 "plan_title": {
                                                        "type": "string",
                                                        "description": "Human title of the recurring Plan at crystallization time"
                                                 },
                                                 "scheduled_at": {
                                                        "type": "string",
                                                        "description": "Scheduled timestamp on the archived occurrence root"
                                                 },
                                                 "rrule": {
                                                        "type": "string",
                                                        "description": "RRULE text from the recurring VTODO master at crystallization time"
                                                 },
                                                 "template": {
                                                        "type": "string",
                                                        "description": "Template name attached to the recurring Plan at crystallization time"
                                                 }
                                          },
                                          "required": ["plan_id", "occurrence_key", "plan_title"],
                                          "additionalProperties": true
                                   }
                            },
                            "additionalProperties": true
                     }
              },
              "plans": {
                     "type": "object",
                     "description": "Metadata keyed by plan identifier",
                     "additionalProperties": {
                            "type": "object",
                            "description": "Metadata for a single plan",
                            "additionalProperties": true
                     }
              }
       },
       "additionalProperties": true
}
