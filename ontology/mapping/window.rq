# The effective window (Decision 48): a condition per bound, its instant on the
# bearer with the text saying which bound it is. From app:notBefore and
# app:lateFrom, so an inherited bound is true of the child.
PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  _:condition a cco:ont00000127 ; obo:BFO_0000178 ?a , _:description .
  _:description a cco:ont00000853 .
  _:bearer a cco:ont00000253 ; obo:BFO_0000101 _:description ;
    cco:ont00001765 ?bound ; cco:ont00001767 ?instant .                  # has text value, has datetime value
} WHERE {
  VALUES (?term ?bound) { (app:notBefore "not before") (app:lateFrom "late from") }
  ?a ?term ?instant .
}
