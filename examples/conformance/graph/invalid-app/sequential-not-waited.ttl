# Under a sequential parent, a child waits on the one before it.
# expect: Waits
@prefix : <https://example.org/fixture#> .
@prefix app: <https://clearhead.dev/vocab/app/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:root a app:Charter ; rdfs:label "Root" ; app:state app:Active ; app:file "charters/README.md" .

:parent a app:Action ; rdfs:label "parent" ; app:state app:NotStarted ; app:partOf :root ;
    app:file "charters/next.actions" ; app:line 1 ;
    app:sequential true .
:first a app:Action ; rdfs:label "first" ; app:state app:NotStarted ; app:partOf :parent ;
    app:file "charters/next.actions" ; app:line 2 .
:second a app:Action ; rdfs:label "second" ; app:state app:NotStarted ; app:partOf :parent ;
    app:file "charters/next.actions" ; app:line 3 .
