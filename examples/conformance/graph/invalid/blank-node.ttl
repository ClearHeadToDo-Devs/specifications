# An action keeps its IRI; only helper nodes may be blank (Decision 49).
# expect: Graph
@prefix : <https://example.org/fixture#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:plan a cco:ont00000974 ; rdfs:label "plan" ; obo:BFO_0000178 :objective , :a .
:objective a cco:ont00000476 ; rdfs:label "objective" .
:a a obo:IAO_0000007 ; rdfs:label "an action" ; obo:BFO_0000178 [ a obo:IAO_0000007 ; rdfs:label "a blank sub-action" ] .
