{
       "$schema": "http://json-schema.org/draft-07/schema#",
       "$id": "https://github.com/ClearHeadToDo-Devs/specifications/schemas/charter_metadata.schema.json",
       "title": "Charter Metadata",
       "description": "Per-charter sidecar for machine-oriented metadata that does not belong in human-readable .actions or .ics files. Keyed by domain concept (charter, acts, plans) with entries keyed by identifier.",
       "type": "object",
       "properties": {
              "charter": {
                     "type": "object",
                     "description": "Metadata about the charter itself",
                     "properties": {
                            "created": {
                                   "type": "string",
                                   "description": "ISO 8601 creation timestamp"
                            }
                     },
                     "additionalProperties": true
              },
              "acts": {
                     "type": "object",
                     "description": "Metadata keyed by act identifier",
                     "additionalProperties": {
                            "type": "object",
                            "description": "Metadata for a single planned act",
                            "properties": {
                                   "created": {
                                          "type": "string",
                                          "description": "ISO 8601 creation timestamp"
                                   },
                                   "source_vevent": {
                                          "type": "string",
                                          "description": "UID of the VEVENT that generated this act"
                                   },
                                   "scheduled_at_sync": {
                                          "type": "string",
                                          "description": "The act's scheduled_at as of the last CalDAV reconcile — the 'B' merge base for the three-way sync (decision 31). Machine-owned: only the reconcile engine writes it. Absent means 'never synced'."
                                   },
                                   "due_date_sync": {
                                          "type": "string",
                                          "description": "The act's due_date as of the last CalDAV reconcile — the 'B' merge base for the deadline. Machine-owned; absent means 'never synced'."
                                   }
                            },
                            "additionalProperties": true
                     }
              },
              "plans": {
                     "type": "object",
                     "description": "Metadata keyed by plan identifier",
                     "additionalProperties": {
                            "type": "object",
                            "description": "Metadata for a single plan",
                            "additionalProperties": true
                     }
              }
       },
       "additionalProperties": true
}
