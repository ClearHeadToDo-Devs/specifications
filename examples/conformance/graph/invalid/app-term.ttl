# No ClearHead vocabulary: the CCO graph is the mapping's output, so no app: term survives in it.
# expect: Graph
@prefix : <https://example.org/fixture#> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix app: <https://clearhead.dev/vocab/app/v1#> .

:plan a cco:ont00000974 ; rdfs:label "plan" ; obo:BFO_0000178 :objective , :a .
:objective a cco:ont00000476 ; rdfs:label "objective" .
:a a obo:IAO_0000007 ; rdfs:label "an action" .

:a app:priority 1 .
