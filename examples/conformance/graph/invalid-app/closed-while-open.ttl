# Only a completed or cancelled action has a closed time.
# expect: Action
@prefix : <https://example.org/fixture#> .
@prefix app: <https://clearhead.dev/vocab/app/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:root a app:Charter ; rdfs:label "Root" ; app:state app:Active ; app:file "charters/README.md" .

:a a app:Action ; rdfs:label "a" ; app:state app:NotStarted ; app:partOf :root ;
    app:file "charters/next.actions" ; app:line 1 ;
    app:closed "2026-10-01T10:00:00"^^xsd:dateTime .
