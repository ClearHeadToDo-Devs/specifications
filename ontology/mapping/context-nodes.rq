# A context node keeps its IRI and label, untyped: a tag may name a site, a
# tool, a person or a state of the doer. Config's hierarchy stays skos:broader.
PREFIX app: <https://clearhead.dev/vocab/app/v1#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?context rdfs:label ?label ; skos:broader ?broader . }
WHERE {
  ?context a app:Context ; rdfs:label ?label .
  OPTIONAL { ?context skos:broader ?broader }
}
